{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Dev Server (SIPus)",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build Production",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    },
    {
      "label": "TypeScript Check",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$tsc"]
    }
  ]
}
